<?xml version="1.0" encoding="utf-8"?>
<!--
  This example has no package references, so it builds with no feed at all.
  Removing the default source keeps `dotnet build` working offline and on a
  machine behind a restrictive proxy. Delete this file if you add a dependency.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
